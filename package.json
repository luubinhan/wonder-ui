{
  "name": "@wonder-ui/react",
  "version": "0.1.0",
  "description": "A playful, kid-friendly React design system",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/wonder-ui.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config vite.docs.config.ts",
    "build": "tsc -p tsconfig.lib.json --noEmit && vite build",
    "build:docs": "tsc --noEmit && vite build --config vite.docs.config.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --config vite.docs.config.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luubinhan/wonder-ui.git"
  },
  "homepage": "https://luubinhan.github.io/wonder-ui/",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4"
  },
  "keywords": [
    "react",
    "design-system",
    "ui",
    "components",
    "kid-friendly"
  ],
  "license": "MIT"
}
